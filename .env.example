# Workspace vault (scanned by backend)
WORKSPACE_ROOT=~/.hermes/workspaces

# SQLite graph database
DB_PATH=backend/library.db

# Comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scan limits
SCAN_MAX_FILES=5000
SCAN_MAX_CHILDREN=50

# Optional: require X-API-Key on mutating HTTP endpoints when set
LGB_API_KEY=

# Max POST mutations per client IP per minute (rescan, imports, create, etc.)
LGB_RATE_LIMIT_PER_MIN=30

# Hide exception details in HTTP 500 responses when true
LGB_PRODUCTION=

# MCP: allow open_in_os tool (unset = disabled)
LGB_MCP_ALLOW_OS_OPEN=

# Import download limits
LGB_DOWNLOAD_TIMEOUT=120
LGB_MAX_ZIP_BYTES=104857600

# Frontend dev proxy target
VITE_API_TARGET=http://localhost:3001

# Optional: send X-API-Key from browser (must match LGB_API_KEY)
VITE_LGB_API_KEY=
