# Vite dev: el proxy usa http://127.0.0.1:3001 (ver vite.config.ts).
# Si el navegador no conecta, el cliente prueba también esta URL directa (CORS permitido).
VITE_API_DIRECT=http://127.0.0.1:3001/api

# Si el backend corre en otro host/puerto (p. ej. Docker):
# VITE_API_TARGET=http://127.0.0.1:3001
# VITE_API_BASE=/api

# Si el backend exige API key (LGB_API_KEY en .env del repo):
# VITE_LGB_API_KEY=tu_clave
